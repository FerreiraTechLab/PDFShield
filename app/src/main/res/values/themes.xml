<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LeitorDePDFSeguro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_security</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Alinhamento global de diálogos no tema base -->
        <item name="alertDialogTheme">@style/CustomDialogTheme</item>
    </style>

    <style name="Theme.LeitorDePDFSeguro" parent="Base.Theme.LeitorDePDFSeguro" />

    <style name="CustomDialogTheme" parent="Theme.Material3.Dark.Dialog.Alert">
        <!-- Fundo do diálogo com bordas arredondadas -->
        <item name="android:windowBackground">@drawable/dialog_background_rounded</item>

        <!-- Força tema escuro fixo -->
        <item name="android:isLightTheme">false</item>

        <!-- Força texto branco em tudo que for possível no diálogo -->
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- CORREÇÃO: Força a cor dos itens de lista (Remover/Backup) -->
        <item name="android:textColorAlertDialogListItem">@color/white</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textAppearanceListItemSmall">@style/CustomDialogTextAppearance</item>

        <!-- Cor dos botões e destaques -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/accent_cyan</item>

        <!-- Estilo dos botões do diálogo -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <!-- Estilo de texto para itens de lista -->
    <style name="CustomDialogTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_cyan</item>
    </style>

    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>
