<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Regras de backup automático do Android.
    
    Apenas dados não-sensíveis são incluídos no backup automático.
    Dados sensíveis (PIN hash, salt, preferências de autenticação, chaves criptográficas) 
    são EXCLUÍDOS para evitar:
    - Sincronização não-autorizada em cloud backup (Google One)
    - Exposição de hashes/salts de PIN em dispositivos secundários
    - Recuperação não-autorizada de chaves biométricas via restore
    
    Documentação:
    https://developer.android.com/guide/topics/data/autobackup
    https://developer.android.com/about/versions/12/backup-restore (API 31+)
-->
<full-backup-content>
    <!-- EXCLUIR: SharedPreferences com dados sensíveis (PIN, biometria, autenticação) -->
    <exclude domain="sharedpref" path="AuthPrefs.xml" />
    
    <!-- EXCLUIR: Android Keystore metadata e encrypted prefs (nunca deve ser incluído em backup) -->
    <exclude domain="sharedpref" path="androidx.security.crypto.prefs.xml" />
    
    <!-- EXCLUIR: Room database (contém URIs de PDFs criptografados e metadados).
         O Room abre o banco como "database-name" (sem extensão .db) — o nome
         real do arquivo no disco, não um nome arbitrário. -->
    <exclude domain="database" path="database-name" />
    <exclude domain="database" path="database-name-wal" />
    <exclude domain="database" path="database-name-shm" />
    
    <!-- EXCLUIR: Cache (contém PDFs decriptografados temporários em memória) -->
    <exclude domain="cache" />
    
    <!-- EXCLUIR: Diretório de dados criptografados -->
    <exclude domain="file" path="EncryptedPDFs/" />
    <exclude domain="file" path="DecryptedPDFs/" />
    
    <!-- 
        NOTA: Sem includes explícitos, NENHUM arquivo é incluído no backup.
        Quando um app implementa exclusões de tudo (como aqui), significa que
        o backup automático está desabilitado de fato. Isso é intencional:
        PDFShield não deve ser sincronizado automaticamente em cloud.
    -->
</full-backup-content>