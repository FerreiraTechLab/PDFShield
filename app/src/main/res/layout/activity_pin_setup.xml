<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context="org.ferreiratechlab.leitordepdfseguro.ui.auth.PinSetupActivity">

    <ImageView
        android:id="@+id/logo_shield"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/setup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/set_up_pin"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toBottomOf="@id/logo_shield"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/setup_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/pin_setup_msg"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/setup_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/dot_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/setup_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/pin_dot_empty" />
    </LinearLayout>

    <include
        android:id="@+id/numpad"
        layout="@layout/layout_numpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/dot_container"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
