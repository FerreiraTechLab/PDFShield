<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <TextView
        android:id="@+id/home_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:text="@string/home_choose_title"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_pdfs_button"
        android:layout_width="220dp"
        android:layout_height="72dp"
        android:layout_marginTop="48dp"
        android:text="@string/home_pdfs_option"
        android:textSize="18sp"
        app:icon="@drawable/baseline_enhanced_encryption_24"
        app:backgroundTint="@color/primary_security"
        app:layout_constraintTop_toBottomOf="@id/home_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_texts_button"
        android:layout_width="220dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:text="@string/home_texts_option"
        android:textSize="18sp"
        app:icon="@android:drawable/ic_menu_edit"
        app:backgroundTint="@color/primary_security"
        app:layout_constraintTop_toBottomOf="@id/open_pdfs_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
