<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/dialog_dot_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="6dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="6dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="6dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="6dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="6dp" android:background="@drawable/pin_dot_empty" />
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="6dp" android:background="@drawable/pin_dot_empty" />
    </LinearLayout>

    <!-- Numpad reduzido para o diálogo -->
    <include
        android:id="@+id/dialog_numpad"
        layout="@layout/layout_numpad"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

</LinearLayout>
